# Backend hiện tại của SHOPTRANS
# Production example: https://api.shoptrans.net
NUXT_PUBLIC_API_BASE_URL=
NUXT_PUBLIC_API_PORT=5001

# URL used by the Admin Console server proxy (no /api suffix)
SHOPTRANS_BACKEND_URL=http://127.0.0.1:5001

# Admin frontend runs independently from the main website
NITRO_PORT=5002
NITRO_HOST=0.0.0.0
PORT=5002

# Only used by the compatibility admin-console API when it runs locally.
ADMIN_USERNAME=TX-ADMIN
ADMIN_PASSWORD=change-me
